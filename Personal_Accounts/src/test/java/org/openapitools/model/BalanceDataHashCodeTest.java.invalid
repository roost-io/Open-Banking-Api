class BalanceDataHashCodeTest {
    @Test
    @Tag("valid")
    void testHashCodeWithValidInputs() {
        BalanceData balanceData1 = new BalanceData();
        balanceData1.setType(BalanceTypeCode.INTERIMBOOKED);
        balanceData1.setCreditDebitIndicator(CreditDebitCode.DEBIT);
        balanceData1.setAmount("100.00");
        balanceData1.setCurrency("USD");
        balanceData1.setDatetime(OffsetDateTime.now());
        BalanceData balanceData2 = new BalanceData();
        balanceData2.setType(BalanceTypeCode.INTERIMBOOKED);
        balanceData2.setCreditDebitIndicator(CreditDebitCode.DEBIT);
        balanceData2.setAmount("100.00");
        balanceData2.setCurrency("USD");
        balanceData2.setDatetime(balanceData1.getDatetime());
        assertEquals(balanceData1.hashCode(), balanceData2.hashCode());
    }
    @Test
    @Tag("valid")
    void testHashCodeWithDifferentObjects() {
        BalanceData balanceData1 = new BalanceData();
        balanceData1.setType(BalanceTypeCode.INTERIMBOOKED);
        balanceData1.setCreditDebitIndicator(CreditDebitCode.DEBIT);
        balanceData1.setAmount("100.00");
        balanceData1.setCurrency("USD");
        balanceData1.setDatetime(OffsetDateTime.now());
        BalanceData balanceData2 = new BalanceData();
        balanceData2.setType(BalanceTypeCode.CLOSINGAVAILABLE);
        balanceData2.setCreditDebitIndicator(CreditDebitCode.CREDIT);
        balanceData2.setAmount("200.00");
        balanceData2.setCurrency("EUR");
        balanceData2.setDatetime(OffsetDateTime.now().plusDays(1));
        assertNotEquals(balanceData1.hashCode(), balanceData2.hashCode());
    }
    @Test
    @Tag("valid")
    void testHashCodeWithNullProperties() {
        BalanceData balanceData1 = new BalanceData();
        balanceData1.setType(null);
        balanceData1.setCreditDebitIndicator(null);
        balanceData1.setAmount(null);
        balanceData1.setCurrency(null);
        balanceData1.setDatetime(null);
        assertNotNull(balanceData1.hashCode());
    }
