class BalanceDataGetTypeTest {
    @Test
    @Tag("valid")
    void validateGetTypeWhenTypeIsSet() {
        BalanceData balanceData = new BalanceData();
        BalanceTypeCode type = BalanceTypeCode.CREDIT;
        balanceData.setType(type);
        
        BalanceTypeCode actualType = balanceData.getType();
        
        assertEquals(type, actualType, "Expected and actual type do not match when type is set");
    }
    @Test
    @Tag("invalid")
    void validateGetTypeWhenTypeIsNotSet() {
        BalanceData balanceData = new BalanceData();
        
        BalanceTypeCode actualType = balanceData.getType();
        
        assertNull(actualType, "Expected null when type is not set");
    }
    @Test
    @Tag("boundary")
    void validateGetTypeWithDifferentTypes() {
        BalanceData balanceData1 = new BalanceData();
        BalanceTypeCode type1 = BalanceTypeCode.CREDIT;
        balanceData1.setType(type1);
        
        BalanceData balanceData2 = new BalanceData();
        BalanceTypeCode type2 = BalanceTypeCode.DEBIT;
        balanceData2.setType(type2);
        BalanceTypeCode actualType1 = balanceData1.getType();
        BalanceTypeCode actualType2 = balanceData2.getType();
        assertEquals(type1, actualType1, "Expected and actual type do not match for first balance data");
        assertEquals(type2, actualType2, "Expected and actual type do not match for second balance data");
    }
