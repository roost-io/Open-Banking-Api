package org.openapitools.configuration;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.openapitools.model.BalanceTypeCode;
import org.springframework.core.convert.converter.Converter;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertNull;
import org.junit.jupiter.api.*;
import org.openapitools.model.AccountStatus;
import org.openapitools.model.AccountSubTypeCode;
import org.openapitools.model.AccountTypeCode;
import org.openapitools.model.ConsentStatusCode;
import org.openapitools.model.CreditDebitCode;
import org.openapitools.model.ExternalPermissionCode;
import org.openapitools.model.ParamName;
import org.openapitools.model.Status;
import org.openapitools.model.SupportedAlgorithms;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

public class EnumConverterConfigurationBalanceTypeCodeConverterTest {
    private EnumConverterConfiguration configuration = new EnumConverterConfiguration();
    @Test
    @Tag("valid")
    public void testSuccessfulConversionToBalanceTypeCode() {
        String validString = "InterimAvailable";
        Converter<String, BalanceTypeCode> converter = configuration.balanceTypeCodeConverter();
        BalanceTypeCode result = converter.convert(validString);
        assertEquals(BalanceTypeCode.INTERIM_AVAILABLE, result, "Expected and actual BalanceTypeCode do not match.");
    }
    @Test
    @Tag("invalid")
    public void testConversionOfInvalidStringToBalanceTypeCode() {
        String invalidString = "InvalidBalanceTypeCode";
        Converter<String, BalanceTypeCode> converter = configuration.balanceTypeCodeConverter();
        Exception exception = assertThrows(IllegalArgumentException.class, () -> {
            BalanceTypeCode result = converter.convert(invalidString);
        });
        String expectedMessage = "No enum constant org.openapitools.model.BalanceTypeCode.InvalidBalanceTypeCode";
        String actualMessage = exception.getMessage();
        assertEquals(expectedMessage, actualMessage, "Expected and actual exception messages do not match.");
    }
    @Test
    @Tag("boundary")
    public void testConversionOfNullStringToBalanceTypeCode() {
        String nullString = null;
        Converter<String, BalanceTypeCode> converter = configuration.balanceTypeCodeConverter();
        BalanceTypeCode result = converter.convert(nullString);
        assertNull(result, "Expected null BalanceTypeCode for null input string.");
    }
}