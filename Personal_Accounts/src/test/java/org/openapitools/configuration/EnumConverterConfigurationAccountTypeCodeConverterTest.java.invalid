package org.openapitools.configuration;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.openapitools.model.AccountTypeCode;
import org.springframework.core.convert.converter.Converter;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import org.junit.jupiter.api.*;
import org.openapitools.model.AccountStatus;
import org.openapitools.model.AccountSubTypeCode;
import org.openapitools.model.BalanceTypeCode;
import org.openapitools.model.ConsentStatusCode;
import org.openapitools.model.CreditDebitCode;
import org.openapitools.model.ExternalPermissionCode;
import org.openapitools.model.ParamName;
import org.openapitools.model.Status;
import org.openapitools.model.SupportedAlgorithms;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

public class EnumConverterConfigurationAccountTypeCodeConverterTest {
    private final EnumConverterConfiguration enumConverterConfiguration = new EnumConverterConfiguration();
    @Test
    @Tag("valid")
    public void testValidAccountTypeCodeConversion() {
        String validAccountTypeCodeString = "Savings";
        Converter<String, AccountTypeCode> converter = enumConverterConfiguration.accountTypeCodeConverter();
        AccountTypeCode actualAccountTypeCode = converter.convert(validAccountTypeCodeString);
        assertEquals(AccountTypeCode.SAVINGS, actualAccountTypeCode, "Valid AccountTypeCode String is not correctly converted to AccountTypeCode Enum");
    }
    @Test
    @Tag("invalid")
    public void testInvalidAccountTypeCodeConversion() {
        String invalidAccountTypeCodeString = "InvalidType";
        Converter<String, AccountTypeCode> converter = enumConverterConfiguration.accountTypeCodeConverter();
        assertThrows(IllegalArgumentException.class, () -> converter.convert(invalidAccountTypeCodeString), "Invalid AccountTypeCode String should throw IllegalArgumentException");
    }
    @Test
    @Tag("boundary")
    public void testNullAccountTypeCodeConversion() {
        String nullAccountTypeCodeString = null;
        Converter<String, AccountTypeCode> converter = enumConverterConfiguration.accountTypeCodeConverter();
        assertThrows(NullPointerException.class, () -> converter.convert(nullAccountTypeCodeString), "Null AccountTypeCode String should throw NullPointerException");
    }
}