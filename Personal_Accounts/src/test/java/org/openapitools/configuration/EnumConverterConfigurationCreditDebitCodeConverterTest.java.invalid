import org.openapitools.model.SupportedAlgorithms;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

@SpringBootTest
public class EnumConverterConfigurationCreditDebitCodeConverterTest {
    @Autowired
    private EnumConverterConfiguration enumConverterConfiguration;
    private Converter<String, CreditDebitCode> creditDebitCodeConverter;
    @BeforeEach
    public void setup() {
        creditDebitCodeConverter = enumConverterConfiguration.creditDebitCodeConverter();
    }
    @Test
    @Tag("valid")
    @DisplayName("Valid CreditDebitCode Conversion")
    public void testValidCreditDebitCodeConversion() {
        String source = "CRDT";
        CreditDebitCode expected = CreditDebitCode.CRDT;
        CreditDebitCode actual = creditDebitCodeConverter.convert(source);
        Assertions.assertEquals(expected, actual, "Valid CreditDebitCode string should be converted to corresponding enum value");
    }
    @Test
    @Tag("invalid")
    @DisplayName("Invalid CreditDebitCode Conversion")
    public void testInvalidCreditDebitCodeConversion() {
        String source = "INVALID";
        Assertions.assertThrows(IllegalArgumentException.class, () -> creditDebitCodeConverter.convert(source), "Invalid CreditDebitCode string should throw exception");
    }
    @Test
    @Tag("boundary")
    @DisplayName("Null CreditDebitCode Conversion")
    public void testNullCreditDebitCodeConversion() {
        Assertions.assertThrows(NullPointerException.class, () -> creditDebitCodeConverter.convert(null), "Null string should throw exception");
    }
}