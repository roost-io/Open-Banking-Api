package org.openapitools.configuration;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Assertions;
import org.springframework.core.convert.converter.Converter;
import org.openapitools.model.Status;
import org.junit.jupiter.api.*;
import org.openapitools.model.AccountStatus;
import org.openapitools.model.AccountSubTypeCode;
import org.openapitools.model.AccountTypeCode;
import org.openapitools.model.BalanceTypeCode;
import org.openapitools.model.ConsentStatusCode;
import org.openapitools.model.CreditDebitCode;
import org.openapitools.model.ExternalPermissionCode;
import org.openapitools.model.ParamName;
import org.openapitools.model.SupportedAlgorithms;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

public class EnumConverterConfigurationStatusConverterTest {
    @Test
    @Tag("valid")
    public void testStatusConverterWithValidInput() {
        EnumConverterConfiguration configuration = new EnumConverterConfiguration();
        Converter<String, Status> converter = configuration.statusConverter();
        String validStatus = "ENABLED";
        Status status = converter.convert(validStatus);
        Assertions.assertEquals(Status.ENABLED, status, "Expected status ENABLED but got different status");
    }
    @Test
    @Tag("invalid")
    public void testStatusConverterWithInvalidInput() {
        EnumConverterConfiguration configuration = new EnumConverterConfiguration();
        Converter<String, Status> converter = configuration.statusConverter();
        String invalidStatus = "INVALID";
        Assertions.assertThrows(IllegalArgumentException.class, () -> {
            converter.convert(invalidStatus);
        }, "Expected IllegalArgumentException to be thrown, but it didn't");
    }
    @Test
    @Tag("boundary")
    public void testStatusConverterWithNullInput() {
        EnumConverterConfiguration configuration = new EnumConverterConfiguration();
        Converter<String, Status> converter = configuration.statusConverter();
        Assertions.assertThrows(NullPointerException.class, () -> {
            converter.convert(null);
        }, "Expected NullPointerException to be thrown, but it didn't");
    }
}